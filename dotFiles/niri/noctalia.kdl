layout {

    focus-ring {
        active-color   "#e48f67"
        inactive-color "#271c16"
        urgent-color   "#fd4663"
    }

    border {
        active-color   "#e48f67"
        inactive-color "#271c16"
        urgent-color   "#fd4663"
    }


    tab-indicator {
        active-color   "#e48f67"
        inactive-color "#853814"
        urgent-color   "#fd4663"
    }

    insert-hint {
        color "#e48f6780"
    }
}

recent-windows {
    highlight {
        active-color "#e48f67"
        urgent-color "#fd4663"
    }
}
